CREATE DATABASE IF NOT EXISTS u147312066_DragonVaultDB;
USE u147312066_DragonVaultDB;

-- Account Holder Table
CREATE TABLE IF NOT EXISTS account_holder (
    account_holder_id INT AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    middle_initial CHAR(1),
    phone_number VARCHAR(15) NOT NULL,
    email VARCHAR(100) NOT NULL,
    username VARCHAR(50) NOT NULL,
    password VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Account Table
CREATE TABLE IF NOT EXISTS account (
    account_number BIGINT PRIMARY KEY,
    account_holder_id INT NOT NULL,
    account_type ENUM('Savings', 'Checking') NOT NULL,
    balance DECIMAL(12,2) DEFAULT 0.00,
    date_opened TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (account_holder_id) REFERENCES account_holder(account_holder_id)
);

-- Bank Teller Table
CREATE TABLE IF NOT EXISTS bank_teller (
    teller_id VARCHAR(10) NOT NULL PRIMARY KEY,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    email VARCHAR(100) NOT NULL,
    branch VARCHAR(50) NOT NULL,
    username VARCHAR(50) NOT NULL,
    password VARCHAR(255) NOT NULL,
    CONSTRAINT unique_email UNIQUE (email),
    CONSTRAINT unique_username UNIQUE (username),
    CONSTRAINT unique_teller_id UNIQUE (teller_id)
);

-- Teller Transaction Table
CREATE TABLE IF NOT EXISTS teller_transaction (
    teller_transaction_id INT AUTO_INCREMENT PRIMARY KEY,
    teller_id VARCHAR(10) NOT NULL,
    account_number BIGINT NOT NULL,
    transaction_type ENUM('Deposit', 'Withdrawal') NOT NULL,
    amount DECIMAL(12,2) NOT NULL,
    transaction_timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (teller_id) REFERENCES bank_teller(teller_id),
    FOREIGN KEY (account_number) REFERENCES account(account_number)
);

-- User Transaction Table
CREATE TABLE IF NOT EXISTS user_transaction (
    user_transaction_id INT AUTO_INCREMENT PRIMARY KEY,
    account_number BIGINT NOT NULL,
    transaction_type ENUM('Internal transfer', 'Transfer to other bank') NOT NULL,
    otp_code VARCHAR(6),
    amount DECIMAL(12,2) NOT NULL,
    transaction_timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    status ENUM('Pending', 'Completed', 'Failed') DEFAULT 'Pending',
    recipient_account_number BIGINT,
    recipient_bank_code VARCHAR(20),
    FOREIGN KEY (account_number) REFERENCES account(account_number)
);

-- OTP Log Table (Optional)
CREATE TABLE IF NOT EXISTS otp_log (
    id INT AUTO_INCREMENT PRIMARY KEY,
    account_number BIGINT NOT NULL,
    otp_code VARCHAR(6) NOT NULL,
    purpose ENUM('Transaction', 'Login') DEFAULT 'Transaction',
    expires_at DATETIME NOT NULL,
    is_used BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (account_number) REFERENCES account(account_number)
);
